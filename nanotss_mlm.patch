+/* ---- Bidirectional scan (masked-LM mode) -------------------------------------
+ * Every sequence-mixing (even) layer is run twice with the SAME weights: once
+ * left-to-right on the sequence, once left-to-right on the time-reversed
+ * sequence (i.e. a right-to-left scan of the original), and the two residual
+ * streams are averaged:   x' = 1/2 ( F(x) + flip(F(flip(x))) )   with F(x)=x+f(x).
+ * This is the Vim / Caduceus-style BiMamba block with tied weights. The local
+ * causal convolution becomes an anti-causal one in the reversed pass and the
+ * plastic/SSM tree state is read from both sides. Odd (FFF) layers are
+ * per-token, so they are run once. Because both directions use the averaged
+ * residual, the adjoint is exact:  g_x = G_f + flip(G_r)  where each direction is
+ * back-propagated with upstream gradient g/2 (the identity path is counted once).
+ * With bidir=0 these helpers reduce to the original per-layer loops. */
+static void stack_fwd(const Cfg*c,const Params*P,const Params*Q,int L,real*x,Work*w){
+    const int d=c->d;const size_t S=(size_t)c->T*NODES(c)*c->n*c->p;
+    Work*r=c->bidir?w->rev:NULL;
+    if(c->bidir&&!r){fprintf(stderr,"bidirectional model without reverse workspace\n");abort();}
+    for(int l=0;l<c->n_layer;l++){
+        if(!(l&1)){memset(w->h,0,S*sizeof(real));if(r)memset(r->h,0,S*sizeof(real));}
+        if(!r||(l&1)){layer_fwd(c,P,Q,l,L,x,w->h,w->tp+l,w);continue;}
+        r->k=w->k;r->no_alt=w->no_alt;r->rng=(w->rng^0x9E3779B97F4A7C15ULL)*0xD1B54A32D192ED03ULL|1;
+        for(int t=0;t<L;t++)memcpy(r->x+(size_t)t*d,x+(size_t)(L-1-t)*d,sizeof(real)*d);
+        layer_fwd(c,P,Q,l,L,x,w->h,w->tp+l,w);
+        layer_fwd(c,P,Q,l,L,r->x,r->h,r->tp+l,r);
+        for(int t=0;t<L;t++){real*xt=x+(size_t)t*d;const real*rt=r->x+(size_t)(L-1-t)*d;for(int i=0;i<d;i++)xt[i]=(real).5*(xt[i]+rt[i]);}
+    }
